@article{stockVectorAutoregressions2001,
  title = {Vector {{Autoregressions}}},
  author = {Stock, James H and Watson, Mark W},
  year = {2001},
  month = nov,
  journal = {Journal of Economic Perspectives},
  volume = {15},
  number = {4},
  pages = {101--115},
  issn = {0895-3309},
  doi = {10.1257/jep.15.4.101},
  urldate = {2025-06-30},
  abstract = {This paper critically reviews the use of vector autoregressions (VARs) for four tasks: data description, forecasting, structural inference, and policy analysis. The paper begins with a review of VAR analysis, highlighting the differences between reduced-form VARs, recursive VARs and structural VARs. A three variable VAR that includes the unemployment rate, price inflation and the short term interest rate is used to show how VAR methods are used for the four tasks. The paper concludes that VARs have proven to be powerful and reliable tools for data description and forecasting, but have been less useful for structural inference and policy analysis.},
  langid = {english},
  file = {/Users/simonochmann/Zotero/storage/2FU2VBIJ/Stock und Watson - 2001 - Vector Autoregressions.pdf}
}
