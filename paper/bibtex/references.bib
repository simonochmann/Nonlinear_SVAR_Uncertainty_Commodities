@article{stockVectorAutoregressions2001,
  title = {Vector {{Autoregressions}}},
  author = {Stock, James H and Watson, Mark W},
  year = {2001},
  month = nov,
  journal = {Journal of Economic Perspectives},
  volume = {15},
  number = {4},
  pages = {101--115},
  issn = {0895-3309},
  doi = {10.1257/jep.15.4.101},
  urldate = {2025-06-30},
  abstract = {This paper critically reviews the use of vector autoregressions (VARs) for four tasks: data description, forecasting, structural inference, and policy analysis. The paper begins with a review of VAR analysis, highlighting the differences between reduced-form VARs, recursive VARs and structural VARs. A three variable VAR that includes the unemployment rate, price inflation and the short term interest rate is used to show how VAR methods are used for the four tasks. The paper concludes that VARs have proven to be powerful and reliable tools for data description and forecasting, but have been less useful for structural inference and policy analysis.},
  langid = {english},
  file = {/Users/simonochmann/Zotero/storage/X8UM3FQZ/Stock und Watson - 2001 - Vector Autoregressions.pdf}
}

@book{tongNonlinearTimeSeries1990,
  title = {Non-Linear {{Time Series}}: {{A Dynamical System Approach}}},
  shorttitle = {Non-Linear {{Time Series}}},
  author = {Tong, Howell},
  year = {1990},
  month = aug,
  publisher = {Oxford University PressOxford},
  doi = {10.1093/oso/9780198522249.001.0001},
  urldate = {2025-08-27},
  abstract = {Abstract             The analysis of time series data has for many years been a central component of statistical research and practice and the theory of linear time series is now well-established. However, the theory of non-linear time series is still a rapidly developing subject. This book is an introduction to some of these developments and the present state of research. It is a theme of this book that developments in the study of dynamical systems have motivated many of the advances covered here. Consequently, Professor Tong discusses in some detail the fundamental concepts of dynamical systems theory such as limit cycles, Lyapunov exponents, thresholds, and stability, and demonstrates their role in the analysis of non-linear time series. The result is a book which provides the first accessible and comprehensive account of these exciting new developments and bridges the gap between linear and chaotic time series analysis. Both statisticians and dynamical system theorists will benefit from this account of the interplay between their subjects and the author has included discussions of many of the outstanding open problems which remain. As a companion to this book, a microcomputer software package is available for the testing for nonlinearity and the fitting of threshold autoregressive models. For more information, please contact the author.},
  isbn = {978-0-19-852224-9 978-1-383-02360-2},
  langid = {english}
}

