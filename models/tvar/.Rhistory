# Merge and calculate spread
bond_spread <- merge(DGS10, DGS2) %>%
na.omit() %>%
as.data.frame() %>%
rownames_to_column("date") %>%
mutate(date = as.Date(date),
spread = DGS10 - DGS2)
library(quantmod)
library(tidyverse)
library(lubridate)
getSymbols(c("DGS10", "DGS2"), src = "FRED")
bond_spread <- merge(DGS10, DGS2) %>%
na.omit() %>%
as.data.frame() %>%
rownames_to_column("date") %>%
mutate(
date = as.Date(date),
spread = DGS10 - DGS2
)
ggplot(bond_spread, aes(x = date, y = spread)) +
geom_line(color = "black", linewidth = 1) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
labs(
title = "US 10Y – 2Y Treasury Spread",
subtitle = "Yield Curve Spread (DGS10 – DGS2)",
x = NULL,
y = "Spread (%)",
caption = "Source: FRED (via quantmod)"
) +
theme_minimal(base_family = "Helvetica") +
theme(
plot.title = element_text(face = "bold", size = 16),
plot.subtitle = element_text(size = 12),
plot.caption = element_text(size = 8, color = "gray40"),
axis.title.y = element_text(face = "bold"),
axis.text = element_text(color = "black"),
panel.grid.minor = element_blank()
)
# d)
set.seed(123)
T2 <- 200
e2 <- rnorm(T2, mean = 0, sd = 1)
beta1 <- 2.4
beta2 <- .8
y22 <- matrix(0,T2,1)
#for-loop
for(i in 3:T2) {
y22[i] <- e2[i] + beta1*e2[i-1] + beta2*e2[i-2]
}
plot(y22, type ="l")
