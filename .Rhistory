#' Log Merge Activity to CSV
#'
#' Records metadata about a merge operation: dataset sizes, matched rows, file sources, and timestamp.
#'
#' @param index_name Canonical index name (e.g., "VIX").
#' @param n_rows_main Number of rows in the main panel (before merge).
#' @param n_rows_index Number of rows in the index panel.
#' @param n_rows_matched Number of rows after merge (i.e., matched).
#' @param source_file_index Source path of the uncertainty index file.
#' @param output_path CSV file to log into.
#' @param verbose Whether to print confirmation to console.
#'
#' @return Invisibly returns the log entry (as a data.frame).
#' @export
log_merge_activity <- function(index_name,
n_rows_main,
n_rows_index,
n_rows_matched,
source_file_index,
output_path,
verbose = FALSE) {
# Validate inputs
stopifnot(
is.character(index_name), length(index_name) == 1,
is.numeric(n_rows_main), is.numeric(n_rows_index), is.numeric(n_rows_matched),
is.character(source_file_index), length(source_file_index) == 1,
is.character(output_path), length(output_path) == 1
)
# Handle potential divide-by-zero
pct_matched <- if (n_rows_main > 0) {
round(100 * n_rows_matched / n_rows_main, 2)
} else {
NA_real_
}
# Build log row
log_entry <- data.frame(
timestamp        = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
index_name       = index_name,
n_rows_main      = n_rows_main,
n_rows_index     = n_rows_index,
n_rows_matched   = n_rows_matched,
pct_matched      = pct_matched,
source_file      = source_file_index,
stringsAsFactors = FALSE
)
# Ensure folder exists
log_dir <- dirname(output_path)
if (!dir.exists(log_dir)) dir.create(log_dir, recursive = TRUE)
# Safe write
tryCatch({
write.table(
log_entry,
file      = output_path,
sep       = ",",
row.names = FALSE,
col.names = !file.exists(output_path),
append    = TRUE
)
if (verbose) {
message(glue::glue("Logged merge of '{index_name}' to {output_path}"))
}
}, error = function(e) {
warning(glue::glue("Failed to log merge activity: {e$message}"))
})
invisible(log_entry)
}
log_merge_activity(
index_name        = "VIX",
n_rows_main       = 200,
n_rows_index      = 210,
n_rows_matched    = 198,
source_file_index = "data/uncertainty/vix.csv",
output_path       = "logs/merge_activity.csv",
verbose           = TRUE
)
write.table(
log_entry,
file      = output_path,
sep       = ",",
row.names = FALSE,
col.names = !file.exists(output_path) || file.size(output_path) == 0,
append    = TRUE
)
#' Log Structured Merge Metadata to JSON
#'
#' Appends detailed metadata for a merge operation to a persistent JSON audit log.
#'
#' @param index_name Canonical name of the uncertainty index (e.g., "VIX").
#' @param n_rows_main Number of rows in the main dataset before merge.
#' @param n_rows_index Number of rows in the index dataset.
#' @param n_rows_matched Number of successfully matched rows.
#' @param source_file_index File path of the uncertainty index CSV.
#' @param output_path JSON file to append to.
#' @param verbose Print confirmation to console?
#' @param extra Optional named list of additional metadata fields.
#'
#' @return Invisibly returns the metadata entry as a list.
#' @export
log_merge_metadata_json <- function(index_name,
n_rows_main,
n_rows_index,
n_rows_matched,
source_file_index,
output_path,
verbose = FALSE,
extra = list()) {
stopifnot(
is.character(index_name), length(index_name) == 1,
is.numeric(n_rows_main), is.numeric(n_rows_index), is.numeric(n_rows_matched),
is.character(source_file_index), length(source_file_index) == 1,
is.character(output_path), length(output_path) == 1,
is.list(extra)
)
# Safely hash file for traceability (if exists)
hash_source <- if (file.exists(source_file_index)) {
tools::md5sum(source_file_index)[[1]]
} else {
NA_character_
}
# Assemble metadata
metadata <- c(
list(
timestamp      = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
index_name     = index_name,
rows_main      = n_rows_main,
rows_index     = n_rows_index,
rows_matched   = n_rows_matched,
pct_matched    = if (n_rows_main > 0) round(100 * n_rows_matched / n_rows_main, 2) else NA_real_,
source_file    = source_file_index,
source_md5     = hash_source
),
extra
)
# Ensure output directory exists
dir.create(dirname(output_path), recursive = TRUE, showWarnings = FALSE)
# Read existing or initialize
combined <- tryCatch({
if (file.exists(output_path)) {
jsonlite::fromJSON(output_path, simplifyVector = FALSE)
} else {
list()
}
}, error = function(e) {
warning(glue::glue("Could not parse existing JSON log: {e$message}"))
list()
})
# Append and write
combined <- append(combined, list(metadata))
tryCatch({
jsonlite::write_json(
combined,
path = output_path,
pretty = TRUE,
auto_unbox = TRUE
)
if (verbose) {
message(glue::glue("JSON log updated for index: {index_name}"))
}
}, error = function(e) {
warning(glue::glue("Failed to write metadata JSON log: {e$message}"))
})
invisible(metadata)
}
