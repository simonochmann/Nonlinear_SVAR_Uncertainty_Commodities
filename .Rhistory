#' Standardize Raw Index Name to Canonical Form
#'
#' @param raw_name A single character string (raw index name).
#' @param to_upper Convert output to uppercase? (default = TRUE)
#' @return Canonical name if recognized; original name otherwise.
#' @export
standardize_index_name <- function(raw_name, to_upper = TRUE) {
stopifnot(is.character(raw_name), length(raw_name) == 1)
normalize <- function(x) tolower(gsub("[^a-z0-9]", "", x))
raw_variants <- c(
"vix", "vix index", "vix_index", "vixindex",
"vxo", "vxo index", "vxo_index", "vxoindex",
"jln", "jln index", "jlnindex", "jlnum1m", "jlnum3m", "jlnum12m",
"ciss", "ciss index", "ciss_index", "cissindex", "cissindexecb", "ecbciss"
)
canonical <- c(
rep("VIX", 4),
rep("VXO", 4),
rep("JLN", 6),
rep("CISS", 6)
)
name_map <- setNames(canonical, normalize(raw_variants))
key <- normalize(raw_name)
if (key %in% names(name_map)) {
out <- name_map[[key]]
} else {
warning(glue::glue("Unknown index name: '{raw_name}'. Returning raw input."))
out <- raw_name
}
if (!to_upper) out <- tolower(out)
unname(out)
}
