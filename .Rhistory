#' Load ECB/Eurostat CISS CSV robustly and return {date, ciss} monthly
load_ciss_csv <- function(path, verbose = TRUE) {
suppressPackageStartupMessages({
library(readr); library(dplyr); library(stringr); library(lubridate)
})
stopifnot(file.exists(path))
clean_nms <- function(x) {
x <- gsub('^"|"$', '', x)
x <- gsub("\\s+", " ", x)
x <- trimws(x)
tolower(x)
}
# 1) Try comma
df <- readr::read_csv(path, show_col_types = FALSE, guess_max = 200000)
if (ncol(df) == 1) {
df <- readr::read_delim(path, delim = ";", show_col_types = FALSE, guess_max = 200000)
}
if (ncol(df) == 1) {
df <- readr::read_delim(path, delim = ";",
locale = readr::locale(decimal_mark = ","),
show_col_types = FALSE, guess_max = 200000)
}
names(df) <- clean_nms(names(df))
if (verbose) cat(" Columns detected in CISS CSV:", paste(names(df), collapse = " | "), "\n")
# Prefer euro area if geo present
if ("geo" %in% names(df)) {
geo_keep <- c("ea","ea19","ea20","ez","euro area","euro_area","ea-19","ea-20")
if (any(tolower(df$geo) %in% geo_keep)) {
df <- df %>% filter(tolower(geo) %in% geo_keep)
}
}
# Detect date column
date_candidates <- c("date","time","time period","time_period","period","obs_time")
date_col <- intersect(date_candidates, names(df))
if (length(date_col) == 0) {
for (nm in names(df)) {
suppressWarnings({
d_try <- as.Date(df[[nm]])
if (mean(!is.na(d_try)) > 0.8) { date_col <- nm; break }
})
if (is.character(df[[nm]]) &&
mean(str_detect(df[[nm]], "^\\d{4}-\\d{2}$"), na.rm = TRUE) > 0.8) {
date_col <- nm; break
}
}
} else date_col <- date_col[1]
if (length(date_col) == 0) stop("Could not detect a date column in CISS file.")
# Detect value column
value_col <- names(df)[str_detect(names(df), "ciss")]
if (length(value_col) == 0) {
# Look for numeric column with small mean
num_candidates <- setdiff(names(df)[vapply(df, function(x) {
suppressWarnings(is.numeric(x) || all(!is.na(as.numeric(x))))
}, logical(1))], date_col)
if (length(num_candidates) > 0) {
val_means <- vapply(num_candidates, function(col) {
mean(suppressWarnings(as.numeric(df[[col]])), na.rm = TRUE)
}, numeric(1))
# Pick first with mean < 2 (CISS values are small decimals)
small_vals <- num_candidates[val_means < 2]
if (length(small_vals) > 0) value_col <- small_vals[1]
}
}
if (length(value_col) == 0) stop("No candidate value column found in CISS file.")
# Normalise date to month start
to_month <- function(x) {
if (inherits(x, "Date")) return(floor_date(x, "month"))
suppressWarnings(d <- as.Date(x))
if (all(is.na(d)) && is.character(x)) suppressWarnings(d <- as.Date(paste0(x, "-01")))
floor_date(d, "month")
}
out <- df %>%
transmute(
date = to_month(.data[[date_col]]),
ciss = readr::parse_number(as.character(.data[[value_col]]))
) %>%
filter(!is.na(date) & !is.na(ciss)) %>%
group_by(date) %>%
summarise(ciss = mean(ciss, na.rm = TRUE), .groups = "drop") %>%
arrange(date)
if (verbose) {
cat(" Loaded CISS | rows:", nrow(out), "|",
format(min(out$date, na.rm=TRUE)), "→", format(max(out$date, na.rm=TRUE)),
"| cols used:", date_col, "/", value_col, "\n")
}
out
}
source("functions/parse_eurostat/load/load_ciss_csv.R")
ciss <- load_ciss_csv(here::here("data","raw","uncertainty_ciss.csv"))
summary(ciss$ciss)
#' Load ECB/Eurostat CISS CSV robustly and return {date, ciss} monthly
load_ciss_csv <- function(path, verbose = TRUE) {
suppressPackageStartupMessages({
library(readr); library(dplyr); library(stringr); library(lubridate)
})
stopifnot(file.exists(path))
clean_nms <- function(x) {
x <- gsub('^"|"$', '', x)
x <- gsub("\\s+", " ", x)
x <- trimws(x)
tolower(x)
}
# First read
df <- read_csv(path, show_col_types = FALSE, guess_max = 200000)
# If it's a one-column mess, try to split the embedded CSV
if (ncol(df) == 1) {
if (verbose) cat(" Detected single-column ECB export — reparsing inner CSV...\n")
# Read file as lines
raw_lines <- read_lines(path)
# Now re-read using read_csv on the text, letting readr handle the quotes
df <- read_csv(paste(raw_lines, collapse = "\n"), show_col_types = FALSE, guess_max = 200000)
}
names(df) <- clean_nms(names(df))
if (verbose) cat(" Columns detected in CISS CSV:", paste(names(df), collapse = " | "), "\n")
# Detect date column
date_candidates <- c("date","time","time period","time_period","period","obs_time")
date_col <- intersect(date_candidates, names(df))
if (length(date_col) == 0) stop("No date column found.")
# Detect value column
value_col <- names(df)[str_detect(names(df), "ciss")]
if (length(value_col) == 0) stop("No column name contains 'ciss'.")
# Normalise date to month start
to_month <- function(x) {
if (inherits(x, "Date")) return(floor_date(x, "month"))
suppressWarnings(d <- as.Date(x))
if (all(is.na(d)) && is.character(x)) suppressWarnings(d <- as.Date(paste0(x, "-01")))
floor_date(d, "month")
}
out <- df %>%
transmute(
date = to_month(.data[[date_col]]),
ciss = parse_number(as.character(.data[[value_col]]))
) %>%
filter(!is.na(date) & !is.na(ciss)) %>%
arrange(date)
if (verbose) {
cat(" Loaded CISS | rows:", nrow(out), "|",
format(min(out$date, na.rm=TRUE)), "→", format(max(out$date, na.rm=TRUE)),
"| cols used:", date_col, "/", value_col, "\n")
}
out
}
