# functions/parse_eurostat/load/load_ciss_csv.R
#' Load ECB/Eurostat CISS CSV robustly and return tidy monthly {date, ciss}
#'
#' Handles:
#' - Proper CSV with separate columns
#' - Single-column quoted CSV (entire row in one string)
#' - Semicolon-delimited + European decimal comma
#' - Weekly/daily data collapsed to monthly (average per month)
#'
#' @param path Path to the raw ECB/Eurostat CISS CSV.
#' @param verbose Print progress info.
#' @return A tibble with columns: date (Date, month start), ciss (numeric).
#' @export
load_ciss_csv <- function(path, verbose = TRUE) {
suppressPackageStartupMessages({
library(readr); library(dplyr); library(stringr); library(lubridate); library(tidyr)
})
stopifnot(file.exists(path))
# Helpers ---------------------------------------------------------------
clean_nms <- function(x) {
x <- gsub('^"|"$', '', x)   # strip outer quotes
x <- gsub("\\s+", " ", x)   # collapse whitespace
x <- trimws(x)
tolower(x)
}
to_month <- function(x) {
if (inherits(x, "Date")) return(floor_date(x, "month"))
d <- suppressWarnings(as.Date(x))
if (all(is.na(d)) && is.character(x)) {
d <- suppressWarnings(as.Date(paste0(x, "-01")))
}
floor_date(d, "month")
}
# Try several parsers ---------------------------------------------------
# 1) Standard comma CSV
df <- readr::read_csv(path, show_col_types = FALSE, guess_max = 200000)
if (ncol(df) == 1) {
# 2) Semicolon CSV
df <- readr::read_delim(path, delim = ";", show_col_types = FALSE, guess_max = 200000)
}
if (ncol(df) == 1) {
# 3) Semicolon + European decimal comma
df <- readr::read_delim(path, delim = ";",
locale = readr::locale(decimal_mark = ","),
show_col_types = FALSE, guess_max = 200000)
}
if (ncol(df) == 1) {
# 4) Fully quoted single-column CSV: parse manually
lines <- readr::read_lines(path)
if (length(lines) < 2L) stop("CISS file appears empty.")
# Parse ALL lines (header + data) as proper CSV with quotes
df <- utils::read.csv(text = paste(lines, collapse = "\n"),
header = TRUE, quote = "\"", sep = ",",
stringsAsFactors = FALSE, check.names = FALSE)
}
names(df) <- clean_nms(names(df))
if (verbose) cat(" Columns detected in CISS CSV:", paste(names(df), collapse = " | "), "\n")
# Some files include many geographies; prefer euro area if present
if ("geo" %in% names(df)) {
geo_keep <- c("ea","ea19","ea20","ez","euro area","euro_area","ea-19","ea-20")
if (any(tolower(df$geo) %in% geo_keep)) {
df <- df %>% filter(tolower(geo) %in% geo_keep)
}
}
# Detect date column ----------------------------------------------------
date_candidates <- c("date","time","time period","time_period","period","obs_time")
date_col <- intersect(date_candidates, names(df))
if (length(date_col) == 0) {
# fallback: first column that parses to Date for >80% rows
date_col <- NA_character_
for (nm in names(df)) {
suppressWarnings({
d_try <- as.Date(df[[nm]])
if (mean(!is.na(d_try)) > 0.8) { date_col <- nm; break }
})
if (is.na(date_col) && is.character(df[[nm]]) &&
mean(str_detect(df[[nm]], "^\\d{4}-\\d{2}$"), na.rm = TRUE) > 0.8) {
date_col <- nm; break
}
}
} else {
date_col <- date_col[1]
}
if (is.na(date_col)) {
stop("Could not detect a date column. Saw: ", paste(names(df), collapse = ", "))
}
# Detect value column ----------------------------------------------------
value_col <- names(df)[stringr::str_detect(names(df), "ciss")]
if (length(value_col) == 0) {
# fallback: choose numeric column with mean between 0 and 1
num_candidates <- names(df)[vapply(df, is.numeric, logical(1))]
if (length(num_candidates) == 0) {
num_candidates <- names(df)[vapply(df, function(x) {
all(!is.na(suppressWarnings(as.numeric(df[[x]]))))
}, logical(1))]
}
if (length(num_candidates) > 0) {
val_means <- vapply(df[num_candidates], function(x) {
m <- mean(suppressWarnings(as.numeric(x)), na.rm = TRUE)
return(m)
}, numeric(1))
value_col <- num_candidates[which.min(abs(val_means - 0.2))] # pick one near small decimal mean
}
}
if (length(value_col) == 0) stop("No candidate value column found in CISS file.")
# Build tidy output
out <- df %>%
transmute(
date = to_month(.data[[date_col]]),
ciss = readr::parse_number(as.character(.data[[value_col]]))
) %>%
filter(!is.na(date) & !is.na(ciss)) %>%
group_by(date) %>%
summarise(ciss = mean(ciss, na.rm = TRUE), .groups = "drop") %>%
arrange(date)
if (verbose) {
cat(" Loaded CISS | rows:", nrow(out), "|",
format(min(out$date, na.rm = TRUE)), "→", format(max(out$date, na.rm = TRUE)),
"| cols used:", date_col, "/", value_col, "\n")
}
out
}
