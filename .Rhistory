#' clean_commodity_returns
#'
#' Cleans a wide-format CSV of commodity prices into monthly log returns.
#'
#' @param filepath Path to the CSV file containing raw price data.
#' @param date_column Name of the column containing dates (default: "date").
#' @param standardize Logical, if TRUE z-score standardization is applied (default: TRUE).
#' @param drop_na Logical, if TRUE drops rows with any NA values (default: TRUE).
#'
#' @return A data.frame of log return series (optionally standardized), wiht a date column.
#'
#' @examples
#' df <- clean_commodity_returns("data/raw/commodity_prices.csv")
#'
#' @export
clean_commodity_returns <- function(filepath,
date_column = "date",
standardize = TRUE,
drop_na = TRUE) {
# Load and parse
raw_df <- readr::read_csv(filepath, show_col_types = FALSE)
# Parse dates + sort
raw_df[[date_column]] <- lubridate::ymd(raw_df[[date_column]])
raw_df <- raw_df[order(raw_df[[date_column]]), ]
# Extract dates and price matrix
dates  <- raw_df[[date_column]]
prices <- as.data.frame(raw_df[, !(names(raw_df) %in% date_column)])
#Compute log returns
log_returns <- diff(log(as.matrix(prices)))
ret_df <- as.data.frame(log_returns)
ret_df[[date_column]] <- dates[-1]
# Reorder
ret_df <- ret_df[, c(date_column, setdiff(names(ret_df), date_column))]
# Drop NA rows if requested
if (drop_na) {
ret_df <- tidyr::drop_na(ret_df)
}
# Standardize if requested
if (standardize) {
ret_df[-1] <- lapply(ret_df[-1], scale)
}
return(ret_df)
}
#' clean_commodity_returns
#'
#' Cleans a wide-format CSV of commodity price series into log returns with optional
#' standardization, frequency conversion, and return type customization.
#'
#' @param filepath Path to raw CSV file (wide format: date, asset1, asset2, ...).
#' @param date_column Name of the column containing date values (default: "date").
#' @param frequency Aggregation level for prices: "monthly" (default), "none" for raw freq.
#' @param return_type Output format: "data.frame" (default), "xts", or "ts".
#' @param standardize Logical. If TRUE, z-score standardization is applied (default: TRUE).
#' @param drop_na Logical. If TRUE, drops rows with any NAs (default: TRUE).
#' @param verbose Logical. If TRUE, prints summary diagnostics (default: TRUE).
#'
#' @return Cleaned log return series in desired format.
#'
#' @examples
#' df <- clean_commodity_returns("data/raw/commodity_prices.csv")
#'
#' @export
clean_commodity_returns <- function(filepath,
date_column = "date",
frequency = "monthly",
return_type = "data.frame",
standardize = TRUE,
drop_na = TRUE,
verbose = TRUE) {
# Dependency check (assumes packages loaded in setup.R)
if (!file.exists(filepath)) stop(" File not found: ", filepath)
# Load CSV and check date column
raw_df <- readr::read_csv(filepath, show_col_types = FALSE)
if (!(date_column %in% names(raw_df))) stop(" Date column not found: ", date_column)
raw_df[[date_column]] <- lubridate::ymd(raw_df[[date_column]])
raw_df <- raw_df[order(raw_df[[date_column]]), ]
# Drop non-numeric columns except date
price_df <- raw_df %>%
dplyr::select(where(is.numeric), all_of(date_column)) %>%
dplyr::relocate(all_of(date_column))
# Convert to xts for resampling
xts_prices <- xts::xts(price_df[ , -1], order.by = price_df[[date_column]])
# Frequency conversion
if (frequency == "monthly") {
xts_prices <- xts::apply.monthly(xts_prices, zoo::last)
}
# Compute log returns
log_ret <- diff(log(xts_prices))
if (drop_na) log_ret <- na.omit(log_ret)
# Standardize if requested
if (standardize) {
log_ret <- scale(log_ret)
}
# Format output
if (return_type == "xts") {
result <- log_ret
} else if (return_type == "ts") {
result <- ts(log_ret, start = c(lubridate::year(start(log_ret)), lubridate::month(start(log_ret))), frequency = 12)
} else {
result <- data.frame(date = zoo::index(log_ret), coredata(log_ret))
}
# Verbose diagnostics
if (verbose) {
cat(" lean_commodity_returns()\n")
cat(" Series:", ncol(log_ret), "\n")
cat(" Observations:", nrow(log_ret), "\n")
cat(" Date range:", format(start(log_ret)), "to", format(end(log_ret)), "\n")
if (drop_na && any(is.na(log_ret))) {
cat(" Warning: NAs remain after NA filtering\n")
}
}
return(result)
}
#' functions/preprocess/prepare_uncertainty_proxies
#'
#' Loads, validates, aligns, smooths, and standardizes multiple macro-financial uncertainty proxies.
#' Returns either a wide or long tidy data frame, with optional visual diagnostics.
#'
#' @param vxo_path Path to CSV with "date" and "vxo" columns
#' @param vix_path Path to CSV with "date" and "vix" columns
#' @param jln_path Path to CSV with "date" and "jln" columns
#' @param ciss_path Path to CSV with "date" and "ciss" columns
#' @param smooth Logical. Whether to apply smoothing (default: TRUE)
#' @param smoothing_method "rollmean" (default), "ema", or "none"
#' @param impute_missing Logical. Interpolate short NA gaps? (default: TRUE)
#' @param align_dates Logical. Keep only common overlapping period? (default: TRUE)
#' @param standardize Logical. Apply z-score normalization (default: TRUE)
#' @param output_format "wide" (default) or "long"
#' @param plot Logical. Show before/after plots (default: FALSE)
#' @param verbose Logical. Print diagnostics (default: TRUE)
#'
#' @return A wide or long tidy data frame of uncertainty proxies
#' @export
prepare_uncertainty_proxoies <- function(vxo_path, vix_path, jln_path, ciss_path,
smooth = TRUE,
smooting_method = "rollmean",
impute_missing = TRUE,
align_dates = TRUE,
standardize = TRUE,
output_format = "wide",
plot = FALSE,
verbose = TRUE) {
# Helper: load and validate each series
load_series <- function(path, name) {
if(!file.exists(path)) stop("File not found: ", path)
df <- readr::read_csv(path, show_col_types = FALSE)
if (!("date" %in% names(df))) stop("Missing 'date' column in ", name)
if (!(name %in% names (df))) stop("Missing '", name, "' column in ", path)
df <- df[, c("date", name)]
df$date <- lubridate::ymd(df$date)
df <- df[order(df$date), ]
df$proxy <- name
colnames(df) <- c("date", "value", "proxy")
return(df)
}
# Load all proxies
proxies <- dplyr::bind_rows(
load_series(vxo_path, "vxo"),
load_series(vix_path, "vix"),
load_series(jln_path, "jln"),
load_series(ciss_path, "ciss")
)
# Smooth each proxy
if (smooth) {
proxies <- proxies %>%
dyplr::group_by(proxy) %>%
dyplr::arrange(date) %>%
dyplr::mutate(value = dyplr::case_when(
smoothing_method == "rollmean" ~zoo::rollmean(value, k = 3, fill = NA, align = "right"),
smoothing_method == "ema" ~TTR::EMA(value, n = 3)
TRUE ~ value
#' prepare_uncertainty_proxies_v2
#'
#' Loads, validates, aligns, smooths, and standardizes multiple macro-financial uncertainty proxies.
#' Returns either a wide or long tidy data frame, with optional visual diagnostics.
#'
#' @param vxo_path Path to CSV with "date" and "vxo" columns
#' @param vix_path Path to CSV with "date" and "vix" columns
#' @param jln_path Path to CSV with "date" and "jln" columns
#' @param ciss_path Path to CSV with "date" and "ciss" columns
#' @param smooth Logical. Whether to apply smoothing (default: TRUE)
#' @param smoothing_method "rollmean" (default), "ema", or "none"
#' @param impute_missing Logical. Interpolate short NA gaps? (default: TRUE)
#' @param align_dates Logical. Keep only common overlapping period? (default: TRUE)
#' @param standardize Logical. Apply z-score normalization (default: TRUE)
#' @param output_format "wide" (default) or "long"
#' @param plot Logical. Show before/after plots (default: FALSE)
#' @param verbose Logical. Print diagnostics (default: TRUE)
#'
#' @return A wide or long tidy data frame of uncertainty proxies
#' @export
prepare_uncertainty_proxies <- function(vxo_path, vix_path, jln_path, ciss_path,
smooth = TRUE,
smoothing_method = "rollmean",
impute_missing = TRUE,
align_dates = TRUE,
standardize = TRUE,
output_format = "wide",
plot = FALSE,
verbose = TRUE) {
# --- Helper: load and validate each series ---
load_series <- function(path, name) {
if (!file.exists(path)) stop("❌ File not found: ", path)
df <- readr::read_csv(path, show_col_types = FALSE)
if (!("date" %in% names(df))) stop("❌ Missing 'date' column in ", name)
if (!(name %in% names(df))) stop("❌ Missing '", name, "' column in ", path)
df <- df[, c("date", name)]
df$date <- lubridate::ymd(df$date)
df <- df[order(df$date), ]
df$proxy <- name
colnames(df) <- c("date", "value", "proxy")
return(df)
}
# --- Load all proxies ---
proxies <- dplyr::bind_rows(
load_series(vxo_path, "vxo"),
load_series(vix_path, "vix"),
load_series(jln_path, "jln"),
load_series(ciss_path, "ciss")
)
# --- Optional: Smooth each proxy ---
if (smooth) {
proxies <- proxies %>%
dplyr::group_by(proxy) %>%
dplyr::arrange(date) %>%
dplyr::mutate(value = dplyr::case_when(
smoothing_method == "rollmean" ~ zoo::rollmean(value, k = 3, fill = NA, align = "right"),
smoothing_method == "ema" ~ TTR::EMA(value, n = 3),
TRUE ~ value
)) %>%
dplyr::ungroup()
}
# --- Optional: Impute short NA gaps (linear interpolation) ---
if (impute_missing) {
proxies <- proxies %>%
dplyr::group_by(proxy) %>%
dplyr::mutate(value = zoo::na.approx(value, na.rm = FALSE, maxgap = 2)) %>%
dplyr::ungroup()
}
# --- Optional: Align common date range ---
if (align_dates) {
common_dates <- proxies %>%
tidyr::drop_na() %>%
dplyr::group_by(proxy) %>%
dplyr::summarise(min_date = min(date), max_date = max(date)) %>%
dplyr::summarise(
start = max(min_date),
end = min(max_date)
)
proxies <- proxies %>%
dplyr::filter(date >= common_dates$start, date <= common_dates$end)
}
# --- Standardize ---
if (standardize) {
proxies <- proxies %>%
dplyr::group_by(proxy) %>%
dplyr::mutate(value = scale(value)[, 1]) %>%
dplyr::ungroup()
}
# --- Diagnostics ---
if (verbose) {
cat("✅ prepare_uncertainty_proxies()\n")
cat("• Proxies loaded:", unique(proxies$proxy), "\n")
cat("• Total observations:", nrow(proxies), "\n")
proxy_stats <- proxies %>%
dplyr::group_by(proxy) %>%
dplyr::summarise(
Start = min(date),
End = max(date),
Obs = dplyr::n(),
NAs = sum(is.na(value)),
Min = min(value, na.rm = TRUE),
Max = max(value, na.rm = TRUE),
Mean = mean(value, na.rm = TRUE),
SD = sd(value, na.rm = TRUE)
)
print(proxy_stats)
}
# --- Optional: Plot before/after per proxy ---
if (plot) {
ggplot2::ggplot(proxies, ggplot2::aes(x = date, y = value)) +
ggplot2::geom_line() +
ggplot2::facet_wrap(~proxy, scales = "free_y", ncol = 2) +
ggplot2::labs(title = "Smoothed + Standardized Uncertainty Proxies",
x = NULL, y = "z-score (3-month smoothed)") +
ggplot2::theme_minimal()
}
# --- Return in requested format ---
if (output_format == "wide") {
proxies_wide <- tidyr::pivot_wider(proxies, names_from = proxy, values_from = value)
return(tidyr::drop_na(proxies_wide))
} else {
return(tidyr::drop_na(proxies))
}
}
#' prepare_uncertainty_proxies_v2
#'
#' Loads, validates, aligns, smooths, and standardizes multiple macro-financial uncertainty proxies.
#' Returns either a wide or long tidy data frame, with optional visual diagnostics.
#'
#' @param vxo_path Path to CSV with "date" and "vxo" columns
#' @param vix_path Path to CSV with "date" and "vix" columns
#' @param jln_path Path to CSV with "date" and "jln" columns
#' @param ciss_path Path to CSV with "date" and "ciss" columns
#' @param smooth Logical. Whether to apply smoothing (default: TRUE)
#' @param smoothing_method "rollmean" (default), "ema", or "none"
#' @param impute_missing Logical. Interpolate short NA gaps? (default: TRUE)
#' @param align_dates Logical. Keep only common overlapping period? (default: TRUE)
#' @param standardize Logical. Apply z-score normalization (default: TRUE)
#' @param output_format "wide" (default) or "long"
#' @param plot Logical. Show before/after plots (default: FALSE)
#' @param verbose Logical. Print diagnostics (default: TRUE)
#'
#' @return A wide or long tidy data frame of uncertainty proxies
#' @export
prepare_uncertainty_proxies <- function(vxo_path, vix_path, jln_path, ciss_path,
smooth = TRUE,
smoothing_method = "rollmean",
impute_missing = TRUE,
align_dates = TRUE,
standardize = TRUE,
output_format = "wide",
plot = FALSE,
verbose = TRUE) {
# load and validate each series
load_series <- function(path, name) {
if (!file.exists(path)) stop("File not found: ", path)
df <- readr::read_csv(path, show_col_types = FALSE)
if (!("date" %in% names(df))) stop("Missing 'date' column in ", name)
if (!(name %in% names(df))) stop("Missing '", name, "' column in ", path)
df <- df[, c("date", name)]
df$date <- lubridate::ymd(df$date)
df <- df[order(df$date), ]
df$proxy <- name
colnames(df) <- c("date", "value", "proxy")
return(df)
}
# Load all proxies
proxies <- dplyr::bind_rows(
load_series(vxo_path, "vxo"),
load_series(vix_path, "vix"),
load_series(jln_path, "jln"),
load_series(ciss_path, "ciss")
)
# Smooth each proxy
if (smooth) {
proxies <- proxies %>%
dplyr::group_by(proxy) %>%
dplyr::arrange(date) %>%
dplyr::mutate(value = dplyr::case_when(
smoothing_method == "rollmean" ~ zoo::rollmean(value, k = 3, fill = NA, align = "right"),
smoothing_method == "ema" ~ TTR::EMA(value, n = 3),
TRUE ~ value
)) %>%
dplyr::ungroup()
}
# Impute short NA gaps (linear interpolation)
if (impute_missing) {
proxies <- proxies %>%
dplyr::group_by(proxy) %>%
dplyr::mutate(value = zoo::na.approx(value, na.rm = FALSE, maxgap = 2)) %>%
dplyr::ungroup()
}
# Align common date range
if (align_dates) {
common_dates <- proxies %>%
tidyr::drop_na() %>%
dplyr::group_by(proxy) %>%
dplyr::summarise(min_date = min(date), max_date = max(date)) %>%
dplyr::summarise(
start = max(min_date),
end = min(max_date)
)
proxies <- proxies %>%
dplyr::filter(date >= common_dates$start, date <= common_dates$end)
}
# Standardize
if (standardize) {
proxies <- proxies %>%
dplyr::group_by(proxy) %>%
dplyr::mutate(value = scale(value)[, 1]) %>%
dplyr::ungroup()
}
# Diagnostics
if (verbose) {
cat("prepare_uncertainty_proxies()\n")
cat("Proxies loaded:", unique(proxies$proxy), "\n")
cat("Total observations:", nrow(proxies), "\n")
proxy_stats <- proxies %>%
dplyr::group_by(proxy) %>%
dplyr::summarise(
Start = min(date),
End = max(date),
Obs = dplyr::n(),
NAs = sum(is.na(value)),
Min = min(value, na.rm = TRUE),
Max = max(value, na.rm = TRUE),
Mean = mean(value, na.rm = TRUE),
SD = sd(value, na.rm = TRUE)
)
print(proxy_stats)
}
# Plot before/after per proxy
if (plot) {
ggplot2::ggplot(proxies, ggplot2::aes(x = date, y = value)) +
ggplot2::geom_line() +
ggplot2::facet_wrap(~proxy, scales = "free_y", ncol = 2) +
ggplot2::labs(title = "Smoothed + Standardized Uncertainty Proxies",
x = NULL, y = "z-score (3-month smoothed)") +
ggplot2::theme_minimal()
}
# Return in requested format
if (output_format == "wide") {
proxies_wide <- tidyr::pivot_wider(proxies, names_from = proxy, values_from = value)
return(tidyr::drop_na(proxies_wide))
} else {
return(tidyr::drop_na(proxies))
}
}
