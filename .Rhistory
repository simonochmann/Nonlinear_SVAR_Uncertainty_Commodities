stop("Input must be a single character string.")
}
# Normalization helper: lowercase and remove non-alphanumerics
normalize <- function(x) tolower(gsub("[^a-z0-9]", "", x))
# Canonical mapping: raw variants → canonical form
raw_variants <- c(
"vix", "vix index", "vix_index", "vixindex",
"vxo", "vxo index", "vxo_index", "vxoindex",
"jln", "jln index", "jlnindex", "jlnum1m", "jlnum3m", "jlnum12m",
"ciss", "ciss index", "ciss_index", "cissindex", "cissindexecb", "ecbciss"
)
canonical_names <- c(
rep("VIX", 4),
rep("VXO", 4),
rep("JLN", 6),
rep("CISS", 6)
)
# Remove duplicates after normalization
normalized_keys <- normalize(raw_variants)
unique_keys <- !duplicated(normalized_keys)
name_map <- setNames(canonical_names[unique_keys], normalized_keys[unique_keys])
# Normalize input and look up
name_clean <- normalize(raw_name)
if (name_clean %in% names(name_map)) {
std_name <- name_map[name_clean]
} else {
warning(glue::glue("Unknown index name: '{raw_name}'. Returning raw input."))
std_name <- raw_name
}
if (!to_upper) {
std_name <- tolower(std_name)
}
return(unname(std_name))  # Remove names from return value
}
