coefficients = coefs,
residuals = residuals,
fitted = fitted,
Y = Y,
X = X,
n_obs = nrow(Y)
)
if (verbose) {
message(paste0("Regime: ", regime, " | Obs: ", nrow(Y)))
}
}
# Return full model object
return(list(
regimes = models,
threshold_value = split_value,
regime_variable = threshold_info$name,
metadata = list(
lag = lag,
variables = vars,
threshold_tag = threshold_info$tag,
total_obs = nrow(df)
)
))
}
